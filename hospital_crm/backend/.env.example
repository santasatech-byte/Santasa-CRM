# Hospital CRM Configuration
APP_NAME="Hospital Lead & Follow-up CRM"
APP_ENV="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000
SECRET_KEY="supersecret-change-in-production-hospital-crm-jwt-key"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# Database (Default: SQLite for local dev/testing, easily switchable to PostgreSQL)
DATABASE_URL="sqlite:///./hospital_crm.db"

# Redis & Background Workers
REDIS_URL="redis://localhost:6379/0"
USE_IN_MEMORY_QUEUE=True

# Telephony Provider (mock / exotel / twilio / asterisk)
TELEPHONY_PROVIDER="mock"
TELEPHONY_API_KEY=""
TELEPHONY_API_SECRET=""
TELEPHONY_ACCOUNT_SID=""
TELEPHONY_WEBHOOK_SECRET="whsec_mock_telephony_secret"

# WhatsApp Provider (mock / meta / gupshup / twilio)
WHATSAPP_PROVIDER="mock"
WHATSAPP_API_KEY=""
WHATSAPP_WEBHOOK_SECRET="whsec_mock_whatsapp_secret"

# Storage for Call Recordings (local / s3 / gcs)
RECORDING_STORAGE_TYPE="local"
RECORDING_STORAGE_PATH="./storage/recordings"

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"
