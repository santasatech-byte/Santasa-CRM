{
  "version": 2,
  "framework": "vite",
  "buildCommand": "cd hospital_crm/frontend && npm install && npm run build",
  "outputDirectory": "hospital_crm/frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://santasa-crm.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
